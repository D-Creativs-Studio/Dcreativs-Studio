# D'Creativs Studio — Environment Variables
# For local development or Vercel Environment Variables

# Resend API Key (Get your free key with 3,000 emails/month at https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# The verified sender address in your Resend account (e.g., hello@dcreativs.com or onboarding@resend.dev for testing)
FROM_EMAIL="D'Creativs Studio <hello@dcreativs.com>"

# Internal studio inbox where incoming project inquiries should be delivered
STUDIO_INBOX_EMAIL=dcreativs.studio@gmail.com
